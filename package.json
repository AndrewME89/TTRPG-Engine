{
  "name": "ttrpg-engine",
  "version": "2.1.0",
  "description": "Build, run, and manage tabletop RPG campaigns in Obsidian.",
  "main": "main.js",
  "private": false,
  "author": "Andrew Edwards",
  "license": "MIT",
  "scripts": {
    "check": "node --check main.js",
    "lint": "eslint main.js",
    "lint:fix": "eslint main.js --fix",
    "validate": "node scripts/validate-manifest.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "build": "node scripts/build.mjs",
    "check-release": "node scripts/check-release-files.mjs",
    "test": "node tests/tile-map.test.js && node tests/phase259.test.js && node tests/phase260.test.js",
    "release": "npm run check && npm run build && npm run check-release && node scripts/package-release.mjs",
    "version-bump": "node scripts/version-bump.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ttrpg",
    "dnd",
    "campaign-management",
    "tile-map"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.0",
    "@typescript-eslint/parser": "^7.0.0",
    "typescript": "^5.0.0"
  }
}
